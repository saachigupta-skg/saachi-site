---
import SiteLayout from "../../layouts/SiteLayout.astro";
import CollectionGrid from "../../components/CollectionGrid.astro";
import { loadEntries } from "../../lib/collection";

const modules = import.meta.glob("./*.astro", { eager: true });
const rawModules = import.meta.glob<string>("./*.astro", { query: "?raw", import: "default", eager: true });
const entries = loadEntries("builds", modules, rawModules);
---

<SiteLayout title="Builds — Saachi K Gupta" description="Project writeups by Saachi K Gupta, with links to live demos.">
  <h1>Builds</h1>

  <p style="max-width: 70ch;">
    I'm learning by building — small things, mostly, that start as "I wonder if I could make that" and end with something that actually works. A mix of AI experiments, creative projects I've been dreaming of, and ideas I finally had time to bring to life — a way to stay curious and remind myself that AI doesn't have to be intimidating.
  </p>
  <p style="max-width: 70ch; margin-top: 12px;">
    These are the projects that made it out of my head and into the world. Some are rough drafts. All have taught me something new.
  </p>

  <CollectionGrid entries={entries} />
</SiteLayout>
