      alt="Morning porch portrait with snow fields and the Cascades behind"
      style="width: 100%; border-radius: 10px; object-fit: cover; aspect-ratio: 4/5;"
    />
    <img loading="lazy"
      src="/images/park-butte/lookout-porch-sunrise-walk.jpg"
