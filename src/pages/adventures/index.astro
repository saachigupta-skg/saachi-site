---
import SiteLayout from "../../layouts/SiteLayout.astro";
import CollectionGrid from "../../components/CollectionGrid.astro";
import { loadEntries } from "../../lib/collection";

const modules = import.meta.glob("./*.astro", { eager: true });
const rawModules = import.meta.glob<string>("./*.astro", { query: "?raw", import: "default", eager: true });
const entries = loadEntries("adventures", modules, rawModules);
---

<SiteLayout title="Adventures — Saachi K Gupta" description="Outdoor and travel writeups by Saachi K Gupta: mountaineering, cycling, skiing, and hiking in the Pacific Northwest.">
  <h1>Adventures</h1>
  <p style="max-width: 70ch;">
    Trip notes, routes, and small musings from the outdoors. PNW mostly — trails, mountains, water.
  </p>

  <CollectionGrid entries={entries} variant="adventure" emptyText="Trip reports coming soon." />
</SiteLayout>
