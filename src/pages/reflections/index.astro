---
import SiteLayout from "../../layouts/SiteLayout.astro";
import CollectionGrid from "../../components/CollectionGrid.astro";
import { loadEntries } from "../../lib/collection";

const modules = import.meta.glob("./*.astro", { eager: true });
const entries = loadEntries("reflections", modules);
---

<SiteLayout title="Reflections — Saachi K Gupta" description="Short notes by Saachi K Gupta on life in Seattle and beyond.">
  <h1>Reflections</h1>
  <p style="max-width: 70ch;">
    Short notes. Unpolished. Things I'm noticing, trying, or working through.
  </p>

  <CollectionGrid entries={entries} variant="reflection" />
</SiteLayout>
