---
import SiteLayout from "../../layouts/SiteLayout.astro";

export const title = "Final Weekend of Funemployment in Seattle";
export const date = "2026-06-16";
export const excerpt =
  "A really good stretch of Seattle summer, capped off by a solo night in a fire lookout, and a reminder of how much worse it could have gone.";
export const tags = ["seattle", "friends", "perspective"];
---

<SiteLayout title={`${title} — Saachi K Gupta`}>
  <h1>{title}</h1>
  <p style="opacity:0.7; font-size: 13px;">{date}</p>

  <h2 style="margin-top: 8px;">The 72 hours</h2>

  <p style="max-width: 75ch;">
    The stretch before I hiked into Park Butte was one of the best few days I've had in Seattle in a while. Friday I sailed to a friend's birthday party at Gasworks and then went to a dog's birthday party. Saturday I paddleboarded with gorgeous views of Rainier with my friend Leah, then swam at Colman Pool with my friend Sarah, where we talked each other into biking <a href="/adventures/biking-sunrise-road">the Sunrise Road</a> the next day. Sunday I did it, then went to a lakeside barbecue. Monday I went to the gym, got on a call with a former coworker to talk through negotiating a new job offer, and had lunch at Google with my friend Owen, who'd done Park Butte as a day hike the week before.
  </p>

  <img
    src="/images/final-weekend/sailing-selfie.jpg"
    alt="Selfie on the sailboat at the marina, Friday"
    style="width: 100%; max-width: 480px; border-radius: 12px; margin: 20px 0;"
  />

  <img
    src="/images/final-weekend/sailing-friend-charcuterie.jpg"
    alt="Friend on the sailboat in a popsicle-print shirt with charcuterie"
    style="width: 100%; max-width: 480px; border-radius: 12px; margin: 20px 0;"
  />

