    src="/images/final-weekend/colman-pool-beach.jpg"
    alt="The shoreline at Colman Pool looking out at the Olympics"
    style="width: 100%; max-width: 480px; border-radius: 12px; margin: 20px 0;"
  />

  <img
    src="/images/final-weekend/colman-pool-cornhole.jpg"
    alt="Sarah and me at the waterfront with cornhole boards and boats"
